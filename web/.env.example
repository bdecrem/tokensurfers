# The phone app sends this in x-surf-key; put the same value in ios/TokenSurfers/App/Secrets.swift.
SURF_APP_KEY=
# Signs account tokens and the surf_session cookie. Any long random string.
SURF_SESSION_SECRET=
# Server-side only. Never ship it in the app.
ANTHROPIC_API_KEY=
# Supabase project with schema/*.sql applied. The service key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional: public site URL (share links, OG card), TestFlight link, GitHub link for the landing page.
SURF_SITE_URL=
SURF_TESTFLIGHT_URL=
SURF_GITHUB_URL=
# Optional: daily ceiling on the agent route, input + output tokens per UTC day (default 10,000,000).
SURF_DAILY_TOKENS=
# Optional: where gallery reports go — an email (through SendGrid) and/or an HTTP endpoint that sends a text.
SURF_REPORT_EMAIL=
SENDGRID_API_KEY=
SURF_REPORT_TEXT_URL=
SURF_REPORT_TEXT_SECRET=
SURF_REPORT_TEXT_TO=
